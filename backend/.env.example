# Copy this file to `.env` and adjust. Never commit `.env`.

# "development" or "production". In production the server refuses to start
# if ADMIN_API_KEY is empty or still starts with "change-me", if
# SUPABASE_JWKS_URL is empty, or if ALLOW_DEV_TOKENS is true.
ENVIRONMENT=development

# Local Docker database from the root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://haddak:haddak@localhost:5433/haddak

# Real sign-ins: Supabase's public signing keys (ES256). Required in production.
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Development tokens (scripts/dev_token.py) are signed with this secret.
# Any long random string works locally.
SUPABASE_JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# true = also accept those development tokens, next to real Supabase tokens.
# MUST be false in production: anyone with the secret could sign in as any
# user. The server refuses to start in production when this is true.
ALLOW_DEV_TOKENS=false

# Secret for the X-Admin-Key header on /api/v1/admin routes and the /admin page.
# Production: a long random value, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-too

# Browser origins (other websites) allowed to call the API, comma-separated.
# Development: * (any) is convenient, e.g. for Expo web.
# Production: do NOT use *. Leave it EMPTY unless a website on another domain
# must call the API. The phone app and the /admin page do not need CORS.
#   CORS_ORIGINS=
#   CORS_ORIGINS=https://haddak.app
CORS_ORIGINS=*

# true only when the server runs behind a proxy / load balancer that sets
# X-Forwarded-For (Render, Railway, Fly.io, ... all do). The rate limits then
# use the real client IP from that header. Keep false when the server is
# reached directly, otherwise clients could fake their IP.
TRUST_PROXY=false

# Number of trusted proxies in front of the API (only used when TRUST_PROXY=true).
# The client IP is read that many entries from the RIGHT of X-Forwarded-For.
# 1 fits a single load balancer. After the first deploy, check the logged
# header on the host and adjust; too low and all users share one limit,
# too high and clients can fake their IP.
PROXY_HOPS=1

# ----- Assistant (POST /api/v1/assist) -----
# Claude API key from console.anthropic.com. Leave empty to switch the
# assistant off: it then answers "unavailable" and the app uses normal search.
# Never commit a real key.
ANTHROPIC_API_KEY=
# The cheapest model on purpose. Change only after running scripts/eval_assist.py.
ASSIST_MODEL=claude-haiku-5-5
# AI requests per IP per day, and the spending cap per calendar month in USD.
ASSIST_DAILY_LIMIT=30
ASSIST_MONTHLY_BUDGET_USD=10
