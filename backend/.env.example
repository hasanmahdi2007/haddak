# Copy this file to `.env` and adjust. Never commit `.env`.

# "development" or "production". In production the server refuses to start
# if ADMIN_API_KEY is empty or still starts with "change-me", if
# SUPABASE_JWKS_URL or SUPABASE_URL is empty, if ALLOW_DEV_TOKENS is true,
# if CORS_ORIGINS is *, or if DATABASE_URL has no ?sslmode=require.
ENVIRONMENT=development

# Local Docker database from the root docker-compose.yml.
# Production: must end with ?sslmode=require (or verify-full), so the
# connection is always encrypted; the server refuses to start otherwise.
DATABASE_URL=postgresql+psycopg://haddak:haddak@localhost:5433/haddak

# Real sign-ins: Supabase's public signing keys (ES256). Required in production.
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# The Supabase project's address, no trailing slash. Required in production:
# photo, story and proof links must point into this project's Storage.
# Empty (development) = any https:// link is accepted.
#   https://<project-ref>.supabase.co
SUPABASE_URL=

# Development tokens (scripts/dev_token.py) are signed with this secret.
# Any long random string works locally.
SUPABASE_JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# true = also accept those development tokens, next to real Supabase tokens.
# MUST be false in production: anyone with the secret could sign in as any
# user. The server refuses to start in production when this is true.
ALLOW_DEV_TOKENS=false

# Secret for the X-Admin-Key header on /api/v1/admin routes and the /admin page.
# Production: a long random value, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-too

# Browser origins (other websites) allowed to call the API, comma-separated.
# Development: * (any) is convenient, e.g. for Expo web.
# Production: do NOT use *. Leave it EMPTY unless a website on another domain
# must call the API. The phone app and the /admin page do not need CORS.
#   CORS_ORIGINS=
#   CORS_ORIGINS=https://haddak.app
CORS_ORIGINS=*

# true only when the server runs behind a proxy / load balancer that sets
# X-Forwarded-For (Render, Railway, Fly.io, ... all do). The rate limits then
# use the real client IP from that header. Keep false when the server is
# reached directly, otherwise clients could fake their IP.
TRUST_PROXY=false

# Number of trusted proxies in front of the API (only used when TRUST_PROXY=true).
# The client IP is read that many entries from the RIGHT of X-Forwarded-For.
# 1 fits a single load balancer. After the first deploy, look in the host's
# logs for "X-Forwarded-For carries N entries" (logged once per start, a
# count only, never addresses) and adjust; too low and all users share one
# limit, too high and clients can fake their IP.
PROXY_HOPS=1

# ----- Assistant (POST /api/v1/assist) -----
# The model name picks the provider: gpt-... = OpenAI, gemini-... = Google,
# claude-... = Anthropic. Only the key of a provider in use is needed. A
# missing key: those sentences get the free keyword search instead.
# Never commit a real key.
OPENAI_API_KEY=
# Must be a Google Cloud project with billing on (paid tier: Google does not
# use the sentences to improve its products).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ASSIST_MODEL=gpt-6-luna
# Model for Arabizi sentences (7ada, baddi, kif...), chosen by script in code.
# Leave empty to use ASSIST_MODEL for everything.
ASSIST_MODEL_ARABIZI=gemini-3.8-flash
# Free AI requests per day (Lebanon time): per signed-in account, per phone when
# signed out, and for everyone on one IP together. Over it, keyword search answers.
ASSIST_DAILY_LIMIT_SIGNED_IN=30
ASSIST_DAILY_LIMIT_ANONYMOUS=15
ASSIST_DAILY_LIMIT_PER_IP=100
# Spending caps in USD: per day (Lebanon time) and per calendar month.
ASSIST_DAILY_BUDGET_USD=1
ASSIST_MONTHLY_BUDGET_USD=10
# Secret for hashing who used the allowance. Required in production: a long random
# string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ASSIST_QUOTA_SECRET=change-me-quota-secret

# ----- Operations -----
# Sentry crash reports. Empty = off. From Sentry → project → Client Keys (DSN).
SENTRY_DSN=
# Contact address shown on /privacy, /terms and /delete-account.
CONTACT_EMAIL=

# ----- Database connections (optional; the defaults suit one API instance) -----
# Why these numbers: docs/SYSTEM_DESIGN.md §6, "Connection budget". Each API
# instance uses at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections, and the
# haddak_api role allows 20 in all.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=3
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=8000

# Used by the Docker image only (not by the app): run `alembic upgrade head`
# when the container starts. true on Render's free plan; false once
# render.yaml's preDeployCommand runs the migrations (docs/DEPLOY.md).
# RUN_MIGRATIONS=true
