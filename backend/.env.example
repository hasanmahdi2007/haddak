# Copy this file to `.env` and adjust. Never commit `.env`.

# Local Docker database from the root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://haddak:haddak@localhost:5433/haddak

# Supabase -> Project Settings -> API -> JWT secret.
# For local development any long random string works (see scripts/dev_token.py).
SUPABASE_JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Optional. If set, tokens are verified with Supabase's public keys instead of
# the secret above, e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Secret for the X-Admin-Key header on /api/v1/admin routes.
ADMIN_API_KEY=change-me-too

# Comma-separated browser origins allowed to call the API, or * for any.
CORS_ORIGINS=*
