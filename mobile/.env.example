# The backend. Unset or empty: the app runs on built-in fake data ("Demo data" pill on Home).
# On a phone, use your computer's LAN address, not localhost, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=

# Sign-in (Supabase project URL and its public "publishable" key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only for a deliberate demo release build without a backend; otherwise leave unset.
# EXPO_PUBLIC_ALLOW_MOCK=1

# Build-time only (EAS env var, see docs/DEPLOY.md): Google Maps key for Android builds.
# GOOGLE_MAPS_ANDROID_API_KEY=
